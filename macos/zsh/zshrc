# ~/.zshrc — macOS y Kali en OrbStack. Un solo archivo para los dos lados:
# lo común va directo y lo propio de cada sistema va en un bloque "if $ES_MAC".
# En el Mac y en Kali ~/.zshrc es un enlace a este archivo del repo.
# Orden: instant prompt, PATH, historial, teclas, completado, plugins, alias, funciones, prompt.

# ----------------------------------------------------------------------------
# Powerlevel10k instant prompt (tiene que ir arriba de todo)
# ----------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

[[ $OSTYPE == darwin* ]] && ES_MAC=true || ES_MAC=false

# ----------------------------------------------------------------------------
# PATH y editor
# ----------------------------------------------------------------------------
# Mac: binarios sin brew (lsd, bat, zoxide, fzf, aerospace, kitty, orb)
export PATH="$HOME/.local/bin:$PATH"

# Editor por defecto (yazi, git, crontab, sudoedit): nvim si esta, si no vim
if command -v nvim >/dev/null; then export EDITOR=nvim; else export EDITOR=vim; fi
export VISUAL=$EDITOR

# ----------------------------------------------------------------------------
# Historial
# ----------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt histignorealldups sharehistory

# ----------------------------------------------------------------------------
# Teclas
# ----------------------------------------------------------------------------
bindkey -e
bindkey '^[[H'    beginning-of-line   # Inicio
bindkey '^[[F'    end-of-line         # Fin
bindkey '^[[3~'   delete-char         # Supr
bindkey '^[[1;3C' forward-word        # Alt + derecha
bindkey '^[[1;3D' backward-word       # Alt + izquierda

# ----------------------------------------------------------------------------
# Completado
# ----------------------------------------------------------------------------
autoload -Uz compinit
compinit

zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' completer _expand _complete
zstyle ':completion:*' format 'Completing %d'
zstyle ':completion:*' group-name ''
# Colores de ls/lsd/completado. dircolors es GNU (Kali lo trae, macOS no): si no
# esta, fijamos un LS_COLORS por defecto. En ambos casos quitamos la negrita.
if command -v dircolors >/dev/null; then
  eval "$(dircolors -b)"
else
  export LS_COLORS="di=34:ln=36:so=35:pi=33:ex=32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=34;42:*.tar=31:*.tgz=31:*.zip=31:*.gz=31:*.bz2=31:*.7z=31"
fi
export LS_COLORS=${LS_COLORS//01;/}        # sin negrita (lsd tambien usa LS_COLORS)
export LS_COLORS=${LS_COLORS//=1;/=}
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' list-prompt %SAt %p: Hit TAB for more, or the character to insert%s
zstyle ':completion:*' matcher-list '' 'm:{a-z}={A-Z}' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=* l:|=*'
zstyle ':completion:*' menu select=long
zstyle ':completion:*' select-prompt %SScrolling active: current selection at %p%s
zstyle ':completion:*' use-compctl false
zstyle ':completion:*' verbose true

zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# ----------------------------------------------------------------------------
# Plugins: clonados en ~/.local/share/zsh/plugins (Mac) o de apt en /usr/share (Kali)
# ----------------------------------------------------------------------------
ZPLUG="$HOME/.local/share/zsh/plugins"

# cargar: hace source del primer archivo que exista de los que se le pasan
cargar() { local f; for f in "$@"; do [ -f "$f" ] && { source "$f"; return; }; done; }

cargar "$ZPLUG/zsh-sudo/sudo.plugin.zsh"                                        # Esc Esc = sudo
cargar "$ZPLUG/zsh-autosuggestions/zsh-autosuggestions.zsh" \
       /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# ----------------------------------------------------------------------------
# Alias comunes
# ----------------------------------------------------------------------------
alias ls='lsd --group-dirs=first'
alias ll='lsd -lh --group-dirs=first'
alias lla='lsd -lha --group-dirs=first'

# En Debian/Kali bat se instala como "batcat"
command -v bat >/dev/null && BAT=bat || BAT=batcat
alias cat="$BAT"
alias catn="$BAT --style=plain"
alias catnp="$BAT --style=plain --paging=never"

command -v nvim >/dev/null && { alias vim='nvim'; alias vi='nvim'; }
alias ..='cd ..'
alias reload='source ~/.zshrc && echo "zsh recargado"'

# ----------------------------------------------------------------------------
# Solo macOS / solo Kali
# ----------------------------------------------------------------------------
if $ES_MAC; then
  # iCloud Drive: "icloud" entra a la carpeta sincronizada
  alias icloud='cd "$HOME/Library/Mobile Documents/com~apple~CloudDocs"'
  alias cl='claude'

  # herdr: una sesion (servidor) separada para trabajo y otra para lo personal.
  # Cada una usa su propia config (~/.config/herdr/sesion-<nombre>.toml, la genera
  # herdr-sesiones.sh) con una etiqueta "● NOMBRE" abajo a la derecha.
  # La sesion "default" de herdr no se usa: hr abre personal.
  hs() {
    local s=${1:-personal} cfg="$HOME/.config/herdr/sesion-${1:-personal}.toml"
    "$HOME/.config/sketchybar/herdr-sesiones.sh" "$s"
    HERDR_CONFIG_PATH="$cfg" herdr --session "$s"
  }
  alias hr='hs personal'
  alias hp='hs personal'
  alias hw='hs trabajo'
  alias hls='herdr session list'
else
  # OrbStack monta el home del Mac en /Users/<usuario>: "mac" va directo
  alias mac="cd /Users/$USER"
  # ~mac = home del Mac: el prompt muestra ~mac/... en vez de /Users/<usuario>/...
  # y sirve para rutas (cd ~mac/hacking)
  hash -d mac="/Users/$USER"
fi

# ----------------------------------------------------------------------------
# gdir: bajar un repo de GitHub, o UNA carpeta, pegando su URL
#   gdir    https://github.com/u/repo/tree/rama/ruta/carpeta  -> ./carpeta (solo archivos)
#   gdir -g https://github.com/u/repo/tree/rama/ruta/carpeta  -> ./repo con git (sparse)
#   gdir    https://github.com/u/repo(.git)                    -> ./repo (solo archivos)
#   gdir -g https://github.com/u/repo(.git)                    -> ./repo con git
# ----------------------------------------------------------------------------
gdir() {
  local git=0
  [[ $1 == -g ]] && { git=1; shift }
  local url=${1%/} u r b p
  url=${url%.git}
  if [[ $url =~ '^https://github\.com/([^/]+)/([^/]+)/tree/([^/]+)(/(.+))?$' ]]; then
    u=$match[1] r=$match[2] b=$match[3] p=$match[5]
  elif [[ $url =~ '^https://github\.com/([^/]+)/([^/]+)$' ]]; then
    u=$match[1] r=$match[2] b=HEAD p=
  else
    echo "uso: gdir [-g] https://github.com/usuario/repo[/tree/rama/carpeta]"; return 1
  fi
  if (( git )); then
    [[ -e $r ]] && { echo "ya existe ./$r"; return 1 }
    local rama=(); [[ $b != HEAD ]] && rama=(--branch "$b")
    if [[ -n $p ]]; then
      git clone --filter=blob:none --sparse $rama "https://github.com/$u/$r.git" "$r" &&
        git -C "$r" sparse-checkout set "$p" && echo "-> ./$r/$p"
    else
      git clone --filter=blob:none $rama "https://github.com/$u/$r.git" "$r" && echo "-> ./$r"
    fi
  else
    local dest=${p:t} tmp=$(mktemp -d) wild=() patron=()
    [[ -z $p ]] && dest=$r
    [[ -e $dest ]] && { echo "ya existe ./$dest"; rm -rf "$tmp"; return 1 }
    if [[ -n $p ]]; then
      tar --version 2>/dev/null | grep -q GNU && wild=(--wildcards)   # bsdtar (Mac) no lo necesita
      patron=("*/$p/*")
    fi
    curl -fsSL "https://codeload.github.com/$u/$r/tar.gz/$b" |
      tar -xz -C "$tmp" --strip-components=1 $wild $patron &&
      mv "$tmp${p:+/$p}" "./$dest" && echo "-> ./$dest"
    rm -rf "$tmp"
  fi
}

# ----------------------------------------------------------------------------
# Funciones del lab (mkt, extractPorts, addhost/delhost): cada sistema tiene la
# suya en ~/.config/lab.zsh (la del Mac usa pbcopy y sed BSD)
# ----------------------------------------------------------------------------
[ -f ~/.config/lab.zsh ] && source ~/.config/lab.zsh

# zoxide: "z nombre" salta a una carpeta ya visitada
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# Ajustes solo de este equipo: no los pisa nada
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# ----------------------------------------------------------------------------
# Prompt: Powerlevel10k
# ----------------------------------------------------------------------------
source "$ZPLUG/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ----------------------------------------------------------------------------
# fzf: Ctrl+R historial, Ctrl+T archivos, Alt+C cd (fzf >=0.48 emite los binds)
# ----------------------------------------------------------------------------
command -v fzf >/dev/null && source <(fzf --zsh)

# El resaltado de sintaxis tiene que cargarse al final
cargar "$ZPLUG/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
       /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
unfunction cargar
